---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import groteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Prism AI 棱镜 · 折射 AI 的每一束光',
  description = 'Prism AI 棱镜：开源、每日更新的 AI 学习站，教你正确高效地使用 AI，从提示词到系统教程，即学即用。',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(base + 'og.png', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('prism:theme');
          // 有存储时尊重用户选择；从未选择过则默认深色（不再跟随系统）
          var dark = stored ? stored === 'dark' : true;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {
          // 读取异常时也默认深色
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link rel="preload" as="font" type="font/woff2" href={groteskUrl} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Prism AI 棱镜 · 内容更新"
      href={base + 'rss.xml'}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prism AI 棱镜" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Prism AI 棱镜 · 开源每日更新的 AI 学习站"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <ParticleBackground />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Search />

    <script>
      // 滚动进入动画
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      if (revealEls.length > 0 && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
