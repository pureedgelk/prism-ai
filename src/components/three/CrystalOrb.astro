---
---

<div class="orb-root" id="orb-root">
  <div class="orb-fallback" id="orb-fallback" aria-hidden="true">
    <span class="fallback-ring r1"></span>
    <span class="fallback-ring r2"></span>
    <span class="fallback-core"></span>
  </div>
  <canvas id="orb-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .orb-root {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 520px;
    margin: 0 auto;
  }

  #orb-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .orb-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .orb-root.is-fallback .orb-fallback {
    display: flex;
  }

  .orb-root.is-fallback #orb-canvas {
    display: none;
  }

  .fallback-core {
    width: 52%;
    height: 52%;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.95), rgba(125, 211, 252, 0.75) 45%, rgba(14, 165, 233, 0.55) 100%);
    box-shadow: 0 0 60px rgba(37, 99, 235, 0.55), inset 0 0 30px rgba(255, 255, 255, 0.8);
    animation: float-y 5s ease-in-out infinite;
  }

  .fallback-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(49, 46, 129, 0.5);
  }

  .r1 {
    width: 72%;
    height: 72%;
    animation: spin-slow 14s linear infinite;
    border-style: dashed;
  }

  .r2 {
    width: 88%;
    height: 88%;
    animation: spin-slow 22s linear infinite reverse;
  }

  @keyframes spin-slow {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .fallback-core,
    .r1,
    .r2 { animation: none; }
  }
</style>

<script>
  const root = document.getElementById('orb-root') as HTMLElement;
  const canvas = document.getElementById('orb-canvas') as HTMLCanvasElement;

  const isMobile = window.matchMedia('(max-width: 820px)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function supportsWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(window.WebGL2RenderingContext && c.getContext('webgl2')) || !!c.getContext('webgl');
    } catch {
      return false;
    }
  }

  if (!supportsWebGL()) {
    root.classList.add('is-fallback');
  } else {
    await init(reducedMotion);
  }

  async function init(lowMotion: boolean) {
    const THREE = await import('three');
    const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js');

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(0, 0, 7.3);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: !isMobile,
      powerPreference: 'high-performance',
      preserveDrawingBuffer: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.5 : 2));

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const group = new THREE.Group();
    scene.add(group);

    // ===== 水晶球本体 =====
    const orbGeo = new THREE.SphereGeometry(1.55, isMobile ? 48 : 80, isMobile ? 48 : 80);
    const orbMat = new THREE.MeshPhysicalMaterial({
      color: new THREE.Color('#dbeffe'),
      metalness: 0,
      roughness: 0.06,
      transmission: 1,
      ior: 1.45,
      thickness: 1.4,
      clearcoat: 1,
      clearcoatRoughness: 0.08,
      attenuationColor: new THREE.Color('#7dd3fc'),
      attenuationDistance: 4,
      envMapIntensity: 1.2,
    });
    const orb = new THREE.Mesh(orbGeo, orbMat);
    group.add(orb);

    // ===== 深邃电蓝贴球光晕（Fresnel + 呼吸）=====
    const glowMat = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uColor: { value: new THREE.Color('#2563eb') },
      },
      vertexShader: `
        varying vec3 vNormal;
        varying vec3 vView;
        void main() {
          vNormal = normalize(normalMatrix * normal);
          vec4 mv = modelViewMatrix * vec4(position, 1.0);
          vView = normalize(-mv.xyz);
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec3 uColor;
        varying vec3 vNormal;
        varying vec3 vView;
        void main() {
          float rim = 1.0 - abs(dot(vNormal, vView));
          float fres = smoothstep(0.2, 1.0, rim);
          fres = pow(fres, 1.8);
          float breathe = 0.72 + 0.28 * sin(uTime * 1.3);
          gl_FragColor = vec4(uColor, fres * 0.7 * breathe);
        }
      `,
      transparent: true,
      blending: THREE.NormalBlending,
      depthWrite: false,
      side: THREE.BackSide,
    });
    const glow = new THREE.Mesh(new THREE.SphereGeometry(1.92, 64, 64), glowMat);
    group.add(glow);

    // ===== 球内粒子（保留）=====
    const innerCount = isMobile ? 260 : 800;
    const innerPositions = new Float32Array(innerCount * 3);
    for (let i = 0; i < innerCount; i++) {
      const r = Math.cbrt(Math.random()) * 1.35;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      innerPositions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
      innerPositions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
      innerPositions[i * 3 + 2] = r * Math.cos(phi);
    }
    const innerGeo = new THREE.BufferGeometry();
    innerGeo.setAttribute('position', new THREE.BufferAttribute(innerPositions, 3));
    const innerMat = new THREE.PointsMaterial({
      color: new THREE.Color('#0ea5e9'),
      size: 0.022,
      transparent: true,
      opacity: 0.85,
      depthWrite: false,
    });
    const innerPoints = new THREE.Points(innerGeo, innerMat);
    group.add(innerPoints);

    // ===== 3 条流动虚线环 =====
    function makeDashLine(R: number) {
      const N = 220;
      const positions = new Float32Array(N * 3);
      const angles = new Float32Array(N);
      for (let i = 0; i < N; i++) {
        const a = (i / N) * Math.PI * 2;
        angles[i] = a;
        positions[i * 3] = Math.cos(a) * R;
        positions[i * 3 + 1] = Math.sin(a) * R;
        positions[i * 3 + 2] = 0;
      }
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      g.setAttribute('aAngle', new THREE.BufferAttribute(angles, 1));
      const m = new THREE.ShaderMaterial({
        uniforms: {
          uTime: { value: 0 },
          uColor: { value: new THREE.Color('#312e81') },
        },
        vertexShader: `
          attribute float aAngle;
          varying float vA;
          void main() {
            vA = aAngle;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform float uTime;
          uniform vec3 uColor;
          varying float vA;
          void main() {
            float seg = fract(vA / 6.2831853 * 26.0 + uTime * 0.35);
            if (seg > 0.55) discard;
            gl_FragColor = vec4(uColor, 0.9);
          }
        `,
        transparent: true,
        depthWrite: false,
      });
      return new THREE.LineLoop(g, m);
    }

    // ===== 沿环分布的白紫粒子 =====
    interface ParticleMeta {
      a: number;
      jR: number;
      jZ: number;
      sp: number;
      R: number;
    }

    function makeRingParticles(R: number, count: number) {
      const positions = new Float32Array(count * 3);
      const kinds = new Float32Array(count);
      const phases = new Float32Array(count);
      const sizes = new Float32Array(count);
      const meta: ParticleMeta[] = [];

      for (let i = 0; i < count; i++) {
        const a = Math.random() * Math.PI * 2;
        const jR = (Math.random() - 0.5) * 0.18;
        const jZ = (Math.random() - 0.5) * 0.18;
        const sp = 0.25 + Math.random() * 0.4;
        meta.push({ a, jR, jZ, sp, R });

        kinds[i] = Math.random() < 0.4 ? 1 : 0;
        phases[i] = Math.random() * Math.PI * 2;
        sizes[i] = 2.8 + Math.random() * 3.2;
      }

      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      g.setAttribute('aKind', new THREE.BufferAttribute(kinds, 1));
      g.setAttribute('aPhase', new THREE.BufferAttribute(phases, 1));
      g.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));

      const m = new THREE.ShaderMaterial({
        uniforms: {
          uTime: { value: 0 },
          uPx: { value: renderer.getPixelRatio() },
          uPurple: { value: new THREE.Color('#7c3aed') },
          uLightPurple: { value: new THREE.Color('#a5b4fc') },
        },
        vertexShader: `
          attribute float aKind;
          attribute float aPhase;
          attribute float aSize;
          uniform float uPx;
          varying float vKind;
          varying float vPh;
          void main() {
            vKind = aKind;
            vPh = aPhase;
            vec4 mv = modelViewMatrix * vec4(position, 1.0);
            gl_PointSize = aSize * uPx * (7.3 / -mv.z);
            gl_Position = projectionMatrix * mv;
          }
        `,
        fragmentShader: `
          uniform float uTime;
          uniform vec3 uPurple;
          uniform vec3 uLightPurple;
          varying float vKind;
          varying float vPh;
          void main() {
            vec2 d = gl_PointCoord - 0.5;
            float dd = length(d);
            if (dd > 0.5) discard;
            float halo = smoothstep(0.5, 0.0, dd);
            float core = smoothstep(0.18, 0.0, dd);
            float twinkle = 0.35 + 0.65 * sin(uTime * 2.2 + vPh);

            vec3 haloCol = vKind > 0.5 ? uLightPurple : uPurple;
            float coreMix = vKind > 0.5 ? 1.0 : 0.55;
            vec3 col = mix(haloCol, vec3(1.0), core * coreMix);
            float alpha = halo * twinkle;
            gl_FragColor = vec4(col, alpha);
          }
        `,
        transparent: true,
        blending: THREE.NormalBlending,
        depthWrite: false,
      });

      const points = new THREE.Points(g, m);
      return { points, geo: g, meta };
    }

    const perRing = isMobile ? 250 : 500;
    const ringConfigs = [
      { R: 2.0, rx: 0.5, ry: 0.3, rz: 0.15, spin: 0.0006 },
      { R: 2.35, rx: -0.7, ry: 0.5, rz: -0.2, spin: -0.0008 },
      { R: 2.7, rx: 0.9, ry: -0.4, rz: 0.3, spin: 0.0005 },
    ];

    interface RingBundle {
      group: THREE.Group;
      dash: THREE.LineLoop;
      particles: ReturnType<typeof makeRingParticles>;
      spin: number;
    }

    const ringBundles: RingBundle[] = [];

    ringConfigs.forEach((cfg) => {
      const rg = new THREE.Group();
      rg.rotation.set(cfg.rx, cfg.ry, cfg.rz);
      const dash = makeDashLine(cfg.R);
      const particles = makeRingParticles(cfg.R, perRing);
      rg.add(dash);
      rg.add(particles.points);
      group.add(rg);
      ringBundles.push({ group: rg, dash, particles, spin: cfg.spin });
    });

    function updateParticles(bundle: RingBundle, dt: number) {
      const arr = bundle.particles.geo.attributes.position.array as Float32Array;
      const meta = bundle.particles.meta;
      for (let i = 0; i < meta.length; i++) {
        const p = meta[i];
        p.a += p.sp * dt;
        const rr = p.R + p.jR;
        arr[i * 3] = Math.cos(p.a) * rr;
        arr[i * 3 + 1] = Math.sin(p.a) * rr;
        arr[i * 3 + 2] = p.jZ;
      }
      bundle.particles.geo.attributes.position.needsUpdate = true;
    }

    // ===== 交互状态 =====
    const pointer = { x: 0, y: 0 };
    const target = { x: 0, y: 0 };

    function onPointerMove(e: PointerEvent) {
      pointer.x = (e.clientX / window.innerWidth - 0.5) * 2;
      pointer.y = (e.clientY / window.innerHeight - 0.5) * 2;
    }
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    function onScroll() {
      const y = window.scrollY;
      const scale = Math.max(0.6, 1 - y / 900);
      group.scale.setScalar(scale);
      root.style.opacity = String(Math.max(0, Math.min(1, 1 - y / 550)));
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    function resize() {
      const w = root.clientWidth;
      const h = root.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener('resize', resize);

    const clock = new THREE.Clock();
    let rafId = 0;
    let visible = true;

    function tick() {
      if (lowMotion) {
        renderer.render(scene, camera);
        return;
      }
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;

      target.x += (pointer.x * 0.7 - target.x) * 0.045;
      target.y += (-pointer.y * 0.5 - target.y) * 0.045;
      camera.position.x = target.x;
      camera.position.y = target.y;
      camera.lookAt(0, 0, 0);

      group.rotation.y += 0.0022;
      innerPoints.rotation.y = t * 0.12;
      innerPoints.rotation.x = t * 0.05;

      glowMat.uniforms.uTime.value = t;

      ringBundles.forEach((bundle) => {
        bundle.group.rotation.z += bundle.spin;
        (bundle.dash.material as THREE.ShaderMaterial).uniforms.uTime.value = t;
        (bundle.particles.points.material as THREE.ShaderMaterial).uniforms.uTime.value = t;
        updateParticles(bundle, dt);
      });

      renderer.render(scene, camera);
      if (visible) rafId = requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          visible = entry.isIntersecting;
          if (visible) {
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(tick);
          } else {
            cancelAnimationFrame(rafId);
          }
        });
      },
      { threshold: 0.05 },
    );
    ringBundles.forEach((bundle) => updateParticles(bundle, 0));

    if (lowMotion) {
      // 低动效：下一绘制帧渲染一次静态画面即停止（preserveDrawingBuffer 保证内容保留）
      rafId = requestAnimationFrame(() => {
        resize();
        renderer.render(scene, camera);
      });
    } else {
      io.observe(root);
      rafId = requestAnimationFrame(tick);
    }

    // ===== 清理 =====
    window.addEventListener('beforeunload', dispose);

    function dispose() {
      cancelAnimationFrame(rafId);
      io.disconnect();
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', resize);
      window.removeEventListener('beforeunload', dispose);
      scene.traverse((obj) => {
        const mesh = obj as THREE.Mesh;
        if (mesh.geometry) mesh.geometry.dispose();
        const mat = mesh.material as THREE.Material | THREE.Material[] | undefined;
        if (Array.isArray(mat)) mat.forEach((m) => m.dispose());
        else mat?.dispose();
      });
      pmrem.dispose();
      renderer.dispose();
    }
  }
</script>
