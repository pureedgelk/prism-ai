---
---

<div class="orb-root" id="orb-root">
  <div class="orb-fallback" id="orb-fallback" aria-hidden="true">
    <span class="fallback-ring r1"></span>
    <span class="fallback-ring r2"></span>
    <span class="fallback-ring r3"></span>
    <span class="fallback-ring r4"></span>
    <span class="fallback-core"></span>
  </div>
  <canvas id="orb-canvas" aria-hidden="true"></canvas>
</div>

<style>
  .orb-root {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 520px;
    margin: 0 auto;
  }

  #orb-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .orb-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .orb-root.is-fallback .orb-fallback {
    display: flex;
  }

  .orb-root.is-fallback #orb-canvas {
    display: none;
  }

  /* 多棱晶体核心（clip-path 多边形 + 半透明紫白） */
  .fallback-core {
    position: relative;
    width: 50%;
    height: 50%;
    clip-path: polygon(
      50% 0%,
      80% 12%,
      100% 38%,
      94% 72%,
      70% 100%,
      30% 100%,
      6% 72%,
      0% 38%,
      20% 12%
    );
    background: linear-gradient(
      150deg,
      rgba(237, 233, 254, 0.55) 0%,
      rgba(196, 181, 253, 0.4) 22%,
      rgba(124, 58, 237, 0.32) 55%,
      rgba(76, 29, 149, 0.4) 100%
    );
    box-shadow: 0 0 60px rgba(124, 58, 237, 0.5),
      inset 0 0 30px rgba(255, 255, 255, 0.3);
    animation: float-y 5s ease-in-out infinite;
  }

  /* 顶部棱面高光 */
  .fallback-core::before {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(50% 0%, 100% 38%, 50% 50%, 0% 38%);
    background: rgba(255, 255, 255, 0.26);
  }

  /* 底部棱面阴影 */
  .fallback-core::after {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(
      50% 50%,
      94% 72%,
      70% 100%,
      30% 100%,
      6% 72%
    );
    background: rgba(76, 29, 149, 0.3);
  }

  .fallback-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(124, 58, 237, 0.4);
  }

  .r1 {
    width: 66%;
    height: 66%;
    animation: spin-slow 14s linear infinite;
    border-style: dashed;
  }

  .r2 {
    width: 80%;
    height: 80%;
    animation: spin-slow 18s linear infinite reverse;
  }

  .r3 {
    width: 92%;
    height: 92%;
    animation: spin-slow 24s linear infinite;
    border-style: dashed;
  }

  .r4 {
    width: 100%;
    height: 100%;
    animation: spin-slow 30s linear infinite reverse;
  }

  @keyframes spin-slow {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fallback-core,
    .r1,
    .r2,
    .r3,
    .r4 {
      animation: none;
    }
  }
</style>

<script>
  const root = document.getElementById('orb-root') as HTMLElement;
  const canvas = document.getElementById('orb-canvas') as HTMLCanvasElement;

  const isMobile = window.matchMedia('(max-width: 820px)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function supportsWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return (
        !!(window.WebGL2RenderingContext && c.getContext('webgl2')) ||
        !!c.getContext('webgl')
      );
    } catch {
      return false;
    }
  }

  if (isMobile || !supportsWebGL()) {
    // 移动端或不支持 WebGL：直接使用纯 CSS 回退，不初始化 three.js
    root.classList.add('is-fallback');
  } else {
    // 桌面端：首屏先显示 CSS 回退，等浏览器空闲（首屏内容渲染后）再初始化 WebGL，
    // 避免 three.js 重活阻塞首屏；timeout 保证最迟 2s 启动
    root.classList.add('is-fallback');
    const run = () => {
      init(reducedMotion).catch(() => {
        // 初始化失败则保持 CSS 回退
      });
    };
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(run, { timeout: 2000 });
    } else {
      window.setTimeout(run, 500);
    }
  }

  async function init(lowMotion: boolean) {
    const THREE = await import('three');
    const { RoomEnvironment } = await import(
      'three/examples/jsm/environments/RoomEnvironment.js'
    );

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(0, 0, 7.3);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: !isMobile,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.5 : 2));

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const group = new THREE.Group();
    scene.add(group);

    // ===== 多棱面球（保持球状，棱面分明 + 轻微海浪起伏）=====
    const ORB_R = 1.55;
    const WAVE_AMP = 0.08; // 幅度小，保持整体球形
    const orbGeo = new THREE.IcosahedronGeometry(ORB_R, 2);
    const posAttr = orbGeo.attributes.position;

    // 保存每个顶点的基准径向方向（PolyhedronGeometry 各面顶点独立，同方向位移可保持无缝）
    const baseDirs = new Float32Array(posAttr.count * 3);
    for (let i = 0; i < posAttr.count; i++) {
      const x = posAttr.getX(i);
      const y = posAttr.getY(i);
      const z = posAttr.getZ(i);
      const len = Math.sqrt(x * x + y * y + z * z) || 1;
      baseDirs[i * 3] = x / len;
      baseDirs[i * 3 + 1] = y / len;
      baseDirs[i * 3 + 2] = z / len;
    }

    // 高透半透明紫面（flatShading 形成棱角分明的多棱面）
    const faceMat = new THREE.MeshStandardMaterial({
      color: new THREE.Color('#8b5cf6'),
      emissive: new THREE.Color('#6d28d9'),
      emissiveIntensity: 0.35,
      metalness: 0.15,
      roughness: 0.25,
      transparent: true,
      opacity: 0.25,
      flatShading: true,
      envMapIntensity: 1.3,
      depthWrite: false,
    });
    const faceMesh = new THREE.Mesh(orbGeo, faceMat);
    group.add(faceMesh);

    // 发光棱线（共享同一几何体，wireframe 棱边网络，半透明亮紫加色发光）
    const wireMat = new THREE.MeshBasicMaterial({
      color: new THREE.Color('#c4b5fd'),
      wireframe: true,
      transparent: true,
      opacity: 0.55,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const wireMesh = new THREE.Mesh(orbGeo, wireMat);
    group.add(wireMesh);

    // 棱面轻微海浪起伏：波沿方位角绕核传播，整体仍近似球体
    function updateOrbSurface(t: number) {
      for (let i = 0; i < posAttr.count; i++) {
        const bx = baseDirs[i * 3];
        const by = baseDirs[i * 3 + 1];
        const bz = baseDirs[i * 3 + 2];
        const azimuth = Math.atan2(bz, bx);
        const polar = Math.acos(THREE.MathUtils.clamp(by, -1, 1));
        const wave =
          Math.sin(azimuth * 2.0 + t * 1.15) +
          Math.cos(polar * 1.5 + t * 0.7) * 0.4;
        const r = ORB_R + wave * WAVE_AMP;
        posAttr.setXYZ(i, bx * r, by * r, bz * r);
      }
      posAttr.needsUpdate = true;
    }

    // ===== 紫色外辉（Fresnel + 呼吸）=====
    const glowMat = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uColor: { value: new THREE.Color('#7c3aed') },
      },
      vertexShader: `
        varying vec3 vNormal;
        varying vec3 vView;
        void main() {
          vNormal = normalize(normalMatrix * normal);
          vec4 mv = modelViewMatrix * vec4(position, 1.0);
          vView = normalize(-mv.xyz);
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec3 uColor;
        varying vec3 vNormal;
        varying vec3 vView;
        void main() {
          float rim = 1.0 - abs(dot(vNormal, vView));
          float fres = smoothstep(0.2, 1.0, rim);
          fres = pow(fres, 1.8);
          float breathe = 0.72 + 0.28 * sin(uTime * 1.3);
          gl_FragColor = vec4(uColor, fres * 0.7 * breathe);
        }
      `,
      transparent: true,
      blending: THREE.NormalBlending,
      depthWrite: false,
      side: THREE.BackSide,
    });
    const glow = new THREE.Mesh(
      new THREE.SphereGeometry(1.95, 32, 32),
      glowMat,
    );
    group.add(glow);

    // ===== 内核粒子云（紫白发光，高透棱面下清晰可见）=====
    const innerCount = 800;
    const innerPositions = new Float32Array(innerCount * 3);
    const innerKinds = new Float32Array(innerCount);
    const innerPhases = new Float32Array(innerCount);
    const innerSizes = new Float32Array(innerCount);
    for (let i = 0; i < innerCount; i++) {
      const r = Math.cbrt(Math.random()) * 1.35;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      innerPositions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
      innerPositions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
      innerPositions[i * 3 + 2] = r * Math.cos(phi);
      innerKinds[i] = Math.random();
      innerPhases[i] = Math.random() * Math.PI * 2;
      innerSizes[i] = 1.8 + Math.random() * 2.6;
    }
    const innerGeo = new THREE.BufferGeometry();
    innerGeo.setAttribute('position', new THREE.BufferAttribute(innerPositions, 3));
    innerGeo.setAttribute('aKind', new THREE.BufferAttribute(innerKinds, 1));
    innerGeo.setAttribute('aPhase', new THREE.BufferAttribute(innerPhases, 1));
    innerGeo.setAttribute('aSize', new THREE.BufferAttribute(innerSizes, 1));

    const innerMat = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uPx: { value: renderer.getPixelRatio() },
        uPurple: { value: new THREE.Color('#7c3aed') },
        uLight: { value: new THREE.Color('#c4b5fd') },
      },
      vertexShader: `
        attribute float aKind;
        attribute float aPhase;
        attribute float aSize;
        uniform float uPx;
        varying float vKind;
        varying float vPhase;
        void main() {
          vKind = aKind;
          vPhase = aPhase;
          vec4 mv = modelViewMatrix * vec4(position, 1.0);
          gl_PointSize = aSize * uPx * (7.3 / -mv.z);
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec3 uPurple;
        uniform vec3 uLight;
        varying float vKind;
        varying float vPhase;
        void main() {
          vec2 d = gl_PointCoord - 0.5;
          float dd = length(d);
          if (dd > 0.5) discard;
          float halo = smoothstep(0.5, 0.0, dd);
          float core = smoothstep(0.16, 0.0, dd);
          float twinkle = 0.4 + 0.6 * sin(uTime * 2.0 + vPhase);
          vec3 base = mix(uPurple, uLight, smoothstep(0.35, 0.8, vKind));
          float whiteAmt = smoothstep(0.82, 1.0, vKind);
          vec3 col = mix(base, vec3(1.0), core * (0.6 + whiteAmt));
          gl_FragColor = vec4(col, halo * twinkle);
        }
      `,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const innerPoints = new THREE.Points(innerGeo, innerMat);
    group.add(innerPoints);

    // ===== 流动虚线环 =====
    function makeDashLine(R: number) {
      const N = 220;
      const positions = new Float32Array(N * 3);
      const angles = new Float32Array(N);
      for (let i = 0; i < N; i++) {
        const a = (i / N) * Math.PI * 2;
        angles[i] = a;
        positions[i * 3] = Math.cos(a) * R;
        positions[i * 3 + 1] = Math.sin(a) * R;
        positions[i * 3 + 2] = 0;
      }
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      g.setAttribute('aAngle', new THREE.BufferAttribute(angles, 1));
      const m = new THREE.ShaderMaterial({
        uniforms: {
          uTime: { value: 0 },
          uColor: { value: new THREE.Color('#5b21b6') },
        },
        vertexShader: `
          attribute float aAngle;
          varying float vA;
          void main() {
            vA = aAngle;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
          }
        `,
        fragmentShader: `
          uniform float uTime;
          uniform vec3 uColor;
          varying float vA;
          void main() {
            float seg = fract(vA / 6.2831853 * 26.0 + uTime * 0.35);
            if (seg > 0.55) discard;
            gl_FragColor = vec4(uColor, 0.9);
          }
        `,
        transparent: true,
        depthWrite: false,
      });
      return new THREE.LineLoop(g, m);
    }

    // ===== 沿环分布的紫白粒子 =====
    interface ParticleMeta {
      a: number;
      jR: number;
      jZ: number;
      sp: number;
      R: number;
    }

    function makeRingParticles(R: number, count: number) {
      const positions = new Float32Array(count * 3);
      const kinds = new Float32Array(count);
      const phases = new Float32Array(count);
      const sizes = new Float32Array(count);
      const meta: ParticleMeta[] = [];

      for (let i = 0; i < count; i++) {
        const a = Math.random() * Math.PI * 2;
        const jR = (Math.random() - 0.5) * 0.18;
        const jZ = (Math.random() - 0.5) * 0.18;
        const sp = 0.25 + Math.random() * 0.4;
        meta.push({ a, jR, jZ, sp, R });

        kinds[i] = Math.random() < 0.45 ? 1 : 0;
        phases[i] = Math.random() * Math.PI * 2;
        sizes[i] = 2.8 + Math.random() * 3.2;
      }

      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      g.setAttribute('aKind', new THREE.BufferAttribute(kinds, 1));
      g.setAttribute('aPhase', new THREE.BufferAttribute(phases, 1));
      g.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));

      const m = new THREE.ShaderMaterial({
        uniforms: {
          uTime: { value: 0 },
          uPx: { value: renderer.getPixelRatio() },
          uPurple: { value: new THREE.Color('#7c3aed') },
          uLightPurple: { value: new THREE.Color('#c4b5fd') },
        },
        vertexShader: `
          attribute float aKind;
          attribute float aPhase;
          attribute float aSize;
          uniform float uPx;
          varying float vKind;
          varying float vPh;
          void main() {
            vKind = aKind;
            vPh = aPhase;
            vec4 mv = modelViewMatrix * vec4(position, 1.0);
            gl_PointSize = aSize * uPx * (7.3 / -mv.z);
            gl_Position = projectionMatrix * mv;
          }
        `,
        fragmentShader: `
          uniform float uTime;
          uniform vec3 uPurple;
          uniform vec3 uLightPurple;
          varying float vKind;
          varying float vPh;
          void main() {
            vec2 d = gl_PointCoord - 0.5;
            float dd = length(d);
            if (dd > 0.5) discard;
            float halo = smoothstep(0.5, 0.0, dd);
            float core = smoothstep(0.18, 0.0, dd);
            float twinkle = 0.35 + 0.65 * sin(uTime * 2.2 + vPh);

            vec3 haloCol = vKind > 0.5 ? uLightPurple : uPurple;
            float coreMix = vKind > 0.5 ? 1.0 : 0.55;
            vec3 col = mix(haloCol, vec3(1.0), core * coreMix);
            float alpha = halo * twinkle;
            gl_FragColor = vec4(col, alpha);
          }
        `,
        transparent: true,
        blending: THREE.NormalBlending,
        depthWrite: false,
      });

      const points = new THREE.Points(g, m);
      return { points, geo: g, meta };
    }

    const perRing = 500;
    // 4 条等间距环（3 → 4），各自倾角与转速
    const ringConfigs = [
      { R: 1.95, rx: 0.5, ry: 0.3, rz: 0.15, spin: 0.0006, phase: 0.0 },
      { R: 2.25, rx: -0.7, ry: 0.5, rz: -0.2, spin: -0.0008, phase: 1.6 },
      { R: 2.55, rx: 0.9, ry: -0.4, rz: 0.3, spin: 0.0005, phase: 3.1 },
      { R: 2.85, rx: -0.4, ry: 0.8, rz: 0.5, spin: -0.0006, phase: 4.7 },
    ];

    interface RingBundle {
      group: THREE.Group;
      dash: THREE.LineLoop;
      particles: ReturnType<typeof makeRingParticles>;
      spin: number;
      phase: number;
    }

    const ringBundles: RingBundle[] = [];

    ringConfigs.forEach((cfg) => {
      const rg = new THREE.Group();
      rg.rotation.set(cfg.rx, cfg.ry, cfg.rz);
      const dash = makeDashLine(cfg.R);
      const particles = makeRingParticles(cfg.R, perRing);
      rg.add(dash);
      rg.add(particles.points);
      group.add(rg);
      ringBundles.push({
        group: rg,
        dash,
        particles,
        spin: cfg.spin,
        phase: cfg.phase,
      });
    });

    // 环粒子沿环运动，并以同频率（1.15）径向波浪与棱面球联动
    function updateParticles(bundle: RingBundle, dt: number, t: number) {
      const arr = bundle.particles.geo.attributes.position.array as Float32Array;
      const meta = bundle.particles.meta;
      const waveR = Math.sin(t * 1.15 + bundle.phase) * 0.05;
      for (let i = 0; i < meta.length; i++) {
        const p = meta[i];
        p.a += p.sp * dt;
        const rr = p.R + p.jR + waveR;
        arr[i * 3] = Math.cos(p.a) * rr;
        arr[i * 3 + 1] = Math.sin(p.a) * rr;
        arr[i * 3 + 2] = p.jZ;
      }
      bundle.particles.geo.attributes.position.needsUpdate = true;
    }

    // ===== 交互状态 =====
    const pointer = { x: 0, y: 0 };
    const target = { x: 0, y: 0 };

    function onPointerMove(e: PointerEvent) {
      pointer.x = (e.clientX / window.innerWidth - 0.5) * 2;
      pointer.y = (e.clientY / window.innerHeight - 0.5) * 2;
    }
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    function onScroll() {
      const y = window.scrollY;
      const scale = Math.max(0.6, 1 - y / 900);
      group.scale.setScalar(scale);
      root.style.opacity = String(Math.max(0, Math.min(1, 1 - y / 550)));
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    function resize() {
      const w = root.clientWidth;
      const h = root.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener('resize', resize);

    const clock = new THREE.Clock();
    let rafId = 0;
    let visible = true;

    function tick() {
      if (lowMotion) {
        renderer.render(scene, camera);
        return;
      }
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;

      target.x += (pointer.x * 0.7 - target.x) * 0.045;
      target.y += (-pointer.y * 0.5 - target.y) * 0.045;
      camera.position.x = target.x;
      camera.position.y = target.y;
      camera.lookAt(0, 0, 0);

      // 整体绕核缓慢旋转
      group.rotation.y += 0.0022;
      // 棱面轻微海浪起伏
      updateOrbSurface(t);
      // 内核粒子缓慢旋转
      innerPoints.rotation.y = t * 0.12;
      innerPoints.rotation.x = t * 0.05;

      glowMat.uniforms.uTime.value = t;
      innerMat.uniforms.uTime.value = t;

      ringBundles.forEach((bundle) => {
        bundle.group.rotation.z += bundle.spin;
        (bundle.dash.material as THREE.ShaderMaterial).uniforms.uTime.value = t;
        (bundle.particles.points.material as THREE.ShaderMaterial).uniforms.uTime.value =
          t;
        updateParticles(bundle, dt, t);
      });

      renderer.render(scene, camera);
      // 首帧 WebGL 渲染完成后移除 CSS 回退（重复调用无副作用）
      root.classList.remove('is-fallback');
      if (visible) rafId = requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          visible = entry.isIntersecting;
          if (visible) {
            cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(tick);
          } else {
            cancelAnimationFrame(rafId);
          }
        });
      },
      { threshold: 0.05 },
    );
    ringBundles.forEach((bundle) => updateParticles(bundle, 0, 0));

    if (lowMotion) {
      // 低动效：下一绘制帧渲染一次静态画面即停止，随后切换到 WebGL 画面
      rafId = requestAnimationFrame(() => {
        resize();
        renderer.render(scene, camera);
        root.classList.remove('is-fallback');
      });
    } else {
      io.observe(root);
      rafId = requestAnimationFrame(tick);
    }

    // ===== 清理 =====
    window.addEventListener('beforeunload', dispose);

    function dispose() {
      cancelAnimationFrame(rafId);
      io.disconnect();
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', resize);
      window.removeEventListener('beforeunload', dispose);
      scene.traverse((obj) => {
        const mesh = obj as THREE.Mesh;
        if (mesh.geometry) mesh.geometry.dispose();
        const mat = mesh.material as THREE.Material | THREE.Material[] | undefined;
        if (Array.isArray(mat)) mat.forEach((m) => m.dispose());
        else mat?.dispose();
      });
      pmrem.dispose();
      renderer.dispose();
    }
  }
</script>
