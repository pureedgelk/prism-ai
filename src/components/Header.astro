---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const path = Astro.url.pathname;

const nav = [
  { href: '', label: '首页', match: (p: string) => p === base || p === base.replace(/\/$/, '') },
  { href: 'prompts', label: '提示词库', match: (p: string) => p.includes(`${base}prompts`) },
  { href: 'tutorials', label: '教程', match: (p: string) => p.includes(`${base}tutorials`) },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={base} aria-label="Prism AI 首页">
      <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="hdr-g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7dd3fc" />
            <stop offset="1" stop-color="#0ea5e9" />
          </linearGradient>
        </defs>
        <path d="M32 8 L52 48 L12 48 Z" fill="url(#hdr-g)" opacity="0.9" />
        <path d="M32 8 L32 48 L12 48 Z" fill="#fff" opacity="0.5" />
      </svg>
      <span class="brand-text">Prism AI <em>棱镜</em></span>
    </a>

    <nav class="nav-desktop" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={base + item.href}
            class:list={['nav-link', { active: item.match(path) }]}
            aria-current={item.match(path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <button id="search-open" class="search-btn" type="button" aria-label="打开搜索">
        <span>搜索…</span>
        <kbd>Ctrl K</kbd>
      </button>
    </nav>

    <button id="menu-toggle" class="menu-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="移动端导航" hidden>
    {
      nav.map((item) => (
        <a
          href={base + item.href}
          class:list={['mobile-link', { active: item.match(path) }]}
          aria-current={item.match(path) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <button id="mobile-search-open" class="mobile-search" type="button">全站搜索</button>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(244, 248, 255, 0.72);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    border-bottom: 1px solid rgba(56, 189, 248, 0.18);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .brand-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-ink-900);
    letter-spacing: 0.02em;
  }

  .brand-text em {
    font-style: normal;
    font-weight: 500;
    color: var(--color-ink-500);
    font-size: 0.85rem;
    margin-left: 0.15rem;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link {
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-ink-700);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-link:hover {
    background: rgba(56, 189, 248, 0.12);
  }

  .nav-link.active {
    color: var(--color-ice-700);
    background: rgba(56, 189, 248, 0.16);
    font-weight: 600;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: 0.5rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    background: rgba(255, 255, 255, 0.6);
    color: var(--color-ink-500);
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .search-btn:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  .search-btn kbd {
    font-family: var(--font-display);
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    background: rgba(14, 165, 233, 0.12);
    border: 1px solid rgba(14, 165, 233, 0.25);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 8px;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-ink-700);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1.5rem 1.25rem;
    gap: 0.25rem;
  }

  .mobile-link,
  .mobile-search {
    text-align: left;
    padding: 0.8rem 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink-700);
    background: none;
    border: none;
    border-bottom: 1px solid rgba(56, 189, 248, 0.14);
    cursor: pointer;
  }

  .mobile-link.active {
    color: var(--color-ice-700);
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .nav-desktop {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }

  @media (min-width: 821px) {
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.toggleAttribute('hidden', open);
  });

  const openSearch = () => window.dispatchEvent(new CustomEvent('prism:search-open'));
  document.getElementById('search-open')?.addEventListener('click', openSearch);
  document.getElementById('mobile-search-open')?.addEventListener('click', () => {
    openSearch();
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('hidden', '');
  });

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearch();
    }
  });
</script>
