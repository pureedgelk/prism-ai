---
// 全站背景粒子网络：白紫蓝（紫为主）发光点 + 靠近自动连线 + 鼠标轻度吸引
---

<canvas id="particle-bg" aria-hidden="true"></canvas>

<style>
  #particle-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  type RGB = [number, number, number];

  // 白紫蓝三色，紫为主（紫 50% / 蓝 30% / 白 20%）
  const PURPLE: RGB = [124, 58, 237]; // #7c3aed
  const BLUE: RGB = [14, 165, 233]; // #0ea5e9
  const WHITE: RGB = [255, 255, 255]; // #ffffff
  const WHITE_HALO: RGB = [182, 216, 245]; // 白色粒子的淡蓝外晕，浅背景上勾勒用

  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    baseVx: number; // 恒定巡航速度（平时规律浮动用）
    baseVy: number;
    r: number; // 核心半径
    color: RGB;
    halo: RGB;
    phase: number;
    twinkleSpeed: number;
  }

  const canvas = document.getElementById('particle-bg') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.matchMedia('(max-width: 768px)').matches;

  let width = 0;
  let height = 0;
  let dpr = 1;
  let particles: Particle[] = [];

  const LINK_DIST = isMobile ? 150 : 220; // 连线距离阈值（增大，让网络张开）
  const ATTRACT_R = isMobile ? 120 : 160; // 鼠标吸引半径
  const CRUISE_SPEED = isMobile ? 42 : 62; // 巡航（平时浮动）速度上限 px/s
  const CHASE_SPEED = isMobile ? 150 : 210; // 鼠标附近朝鼠标靠拢的速度
  const CHASE_MAX = isMobile ? 220 : 300; // 鼠标跟随时允许的最大速度（跟得上鼠标）
  const MAX_LINKS = 2; // 每个粒子最多连最近的 2 条，避免放射状乱线

  const mouse = { x: -9999, y: -9999, active: false };
  const mouseVel = { x: 0, y: 0 }; // 鼠标自身移动速度
  let lastPointer = { x: 0, y: 0, t: 0 };

  function pickColor(): { color: RGB; halo: RGB } {
    const n = Math.random();
    if (n < 0.5) return { color: PURPLE, halo: PURPLE };
    if (n < 0.8) return { color: BLUE, halo: BLUE };
    return { color: WHITE, halo: WHITE_HALO };
  }

  function targetCount(): number {
    const area = window.innerWidth * window.innerHeight;
    // 参考桌面面积下约 105 个，按面积比例缩放
    const base = Math.round(area / 14000);
    if (isMobile) return Math.min(60, Math.max(35, base));
    return Math.min(120, Math.max(70, base));
  }

  function createParticles(): void {
    const count = targetCount();
    particles = [];
    for (let i = 0; i < count; i++) {
      const { color, halo } = pickColor();
      const bvx = (Math.random() - 0.5) * 70;
      const bvy = (Math.random() - 0.5) * 70;
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: bvx,
        vy: bvy,
        baseVx: bvx,
        baseVy: bvy,
        r: 1.6 + Math.random() * 1.4,
        color,
        halo,
        phase: Math.random() * Math.PI * 2,
        twinkleSpeed: 0.6 + Math.random() * 0.7,
      });
    }
  }

  function resize(): void {
    width = window.innerWidth;
    height = window.innerHeight;
    dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2);
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (particles.length === 0) createParticles();
  }

  function rgba(c: RGB, a: number): string {
    return `rgba(${c[0]},${c[1]},${c[2]},${a})`;
  }

  function mix(a: RGB, b: RGB): RGB {
    return [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2];
  }

  function drawLinks(): void {
    const n = particles.length;
    const edges = new Set<string>();

    // 每个粒子只保留最近的 MAX_LINKS 个邻居
    for (let i = 0; i < n; i++) {
      const p = particles[i];
      const neighbors: { j: number; d: number }[] = [];
      for (let j = 0; j < n; j++) {
        if (j === i) continue;
        const q = particles[j];
        const dx = p.x - q.x;
        const dy = p.y - q.y;
        const d2 = dx * dx + dy * dy;
        if (d2 <= LINK_DIST * LINK_DIST) {
          neighbors.push({ j, d: Math.sqrt(d2) });
        }
      }
      neighbors.sort((a, b) => a.d - b.d);
      for (let k = 0; k < Math.min(MAX_LINKS, neighbors.length); k++) {
        const a = Math.min(i, neighbors[k].j);
        const b = Math.max(i, neighbors[k].j);
        edges.add(a + ':' + b);
      }
    }

    // 去重后统一绘制，透明度只随距离、不随闪烁跳动
    for (const edge of edges) {
      const [i, j] = edge.split(':').map(Number);
      const p = particles[i];
      const q = particles[j];
      const d = Math.hypot(p.x - q.x, p.y - q.y);
      const strength = (1 - d / LINK_DIST) * 0.4;
      ctx!.strokeStyle = rgba(mix(p.color, q.color), strength);
      ctx!.lineWidth = 1;
      ctx!.beginPath();
      ctx!.moveTo(p.x, p.y);
      ctx!.lineTo(q.x, q.y);
      ctx!.stroke();
    }
  }

  function drawPoints(t: number): void {
    for (const p of particles) {
      const tw = 0.4 + 0.6 * Math.sin(t * p.twinkleSpeed + p.phase);

      // 柔和外晕
      ctx!.fillStyle = rgba(p.halo, 0.12 * tw);
      ctx!.beginPath();
      ctx!.arc(p.x, p.y, p.r * 3.0, 0, Math.PI * 2);
      ctx!.fill();

      // 明亮核心（向白色混合）
      const core: RGB = [
        Math.round(p.color[0] + (255 - p.color[0]) * 0.55),
        Math.round(p.color[1] + (255 - p.color[1]) * 0.55),
        Math.round(p.color[2] + (255 - p.color[2]) * 0.55),
      ];
      ctx!.fillStyle = rgba(core, 0.85 * tw);
      ctx!.beginPath();
      ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx!.fill();
    }
  }

  function update(dt: number): void {
    // 鼠标停下后，鼠标速度快速衰减到 0
    const mDecay = Math.exp(-6 * dt);
    mouseVel.x *= mDecay;
    mouseVel.y *= mDecay;

    // 巡航回归（自然）与鼠标跟随（快速跟手）的平滑系数
    const cruiseLerp = 1 - Math.exp(-3 * dt);
    const chaseLerp = 1 - Math.exp(-10 * dt);

    for (const p of particles) {
      let targetVx = p.baseVx;
      let targetVy = p.baseVy;
      let lerp = cruiseLerp;
      let maxSp = CRUISE_SPEED;

      // 鼠标吸引范围内：目标 = 朝鼠标靠拢 + 鼠标自身移动速度
      if (mouse.active) {
        const dx = mouse.x - p.x;
        const dy = mouse.y - p.y;
        const d = Math.hypot(dx, dy);
        if (d < ATTRACT_R) {
          const influence = 1 - d / ATTRACT_R; // 越靠近鼠标越强
          const ux = d > 0.01 ? dx / d : 0;
          const uy = d > 0.01 ? dy / d : 0;
          const chase = CHASE_SPEED * influence;
          targetVx = ux * chase + mouseVel.x * influence;
          targetVy = uy * chase + mouseVel.y * influence;
          lerp = chaseLerp;
          maxSp = CHASE_MAX;
        }
      }

      // 速度向目标平滑逼近（不再用阻尼衰减到零）
      p.vx += (targetVx - p.vx) * lerp;
      p.vy += (targetVy - p.vy) * lerp;

      // 限速
      const sp = Math.hypot(p.vx, p.vy);
      if (sp > maxSp) {
        p.vx = (p.vx / sp) * maxSp;
        p.vy = (p.vy / sp) * maxSp;
      }

      p.x += p.vx * dt;
      p.y += p.vy * dt;

      // 边界反弹（巡航方向同步翻转）
      if (p.x < 0) {
        p.x = 0;
        p.vx = Math.abs(p.vx);
        p.baseVx = Math.abs(p.baseVx);
      } else if (p.x > width) {
        p.x = width;
        p.vx = -Math.abs(p.vx);
        p.baseVx = -Math.abs(p.baseVx);
      }
      if (p.y < 0) {
        p.y = 0;
        p.vy = Math.abs(p.vy);
        p.baseVy = Math.abs(p.baseVy);
      } else if (p.y > height) {
        p.y = height;
        p.vy = -Math.abs(p.vy);
        p.baseVy = -Math.abs(p.baseVy);
      }
    }
  }

  function render(t: number): void {
    ctx!.clearRect(0, 0, width, height);
    drawLinks();
    drawPoints(t);
  }

  let rafId = 0;
  let last = performance.now();
  let running = false;

  function frame(now: number): void {
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    update(dt);
    render(now / 1000);
    if (running) rafId = requestAnimationFrame(frame);
  }

  function start(): void {
    if (running) return;
    running = true;
    last = performance.now();
    rafId = requestAnimationFrame(frame);
  }

  function stop(): void {
    running = false;
    cancelAnimationFrame(rafId);
  }

  // ===== 事件 =====
  window.addEventListener(
    'pointermove',
    (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.active = true;

      // 计算鼠标瞬时速度并平滑
      const now = performance.now();
      if (lastPointer.t > 0) {
        const dtm = Math.max((now - lastPointer.t) / 1000, 0.001);
        let mvx = (e.clientX - lastPointer.x) / dtm;
        let mvy = (e.clientY - lastPointer.y) / dtm;
        const ms = Math.hypot(mvx, mvy);
        if (ms > CHASE_MAX) {
          mvx = (mvx / ms) * CHASE_MAX;
          mvy = (mvy / ms) * CHASE_MAX;
        }
        mouseVel.x = mouseVel.x * 0.6 + mvx * 0.4;
        mouseVel.y = mouseVel.y * 0.6 + mvy * 0.4;
      }
      lastPointer.x = e.clientX;
      lastPointer.y = e.clientY;
      lastPointer.t = now;
    },
    { passive: true },
  );
  window.addEventListener(
    'pointerleave',
    () => {
      mouse.active = false;
      lastPointer.t = 0;
    },
    { passive: true },
  );

  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      resize();
      if (reducedMotion) render(performance.now() / 1000);
    }, 150);
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stop();
    } else if (!reducedMotion) {
      start();
    }
  });

  // ===== 启动 =====
  resize();
  if (reducedMotion) {
    // 减少动画：只渲染一帧静态网络
    render(0);
  } else {
    start();
  }
</script>
