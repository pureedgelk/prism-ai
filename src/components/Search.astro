---
const base = import.meta.env.BASE_URL;
---

<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-modal glass-panel" role="dialog" aria-modal="true" aria-label="全站搜索">
    <div class="modal-input">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
      </svg>
      <input id="search-input" type="search" placeholder="搜索提示词与教程全文…" autocomplete="off" aria-label="搜索关键词" />
      <kbd>Esc</kbd>
    </div>
    <div class="search-results" id="search-results">
      <p class="search-hint">输入关键词，结果将显示在这里</p>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(15, 37, 64, 0.28);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 1.2rem 2rem;
  }

  .search-modal {
    width: 100%;
    max-width: 640px;
    padding: 1.1rem;
    max-height: 76vh;
    display: flex;
    flex-direction: column;
  }

  .modal-input {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: var(--color-ink-500);
  }

  .modal-input input {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    font-size: 1rem;
    color: var(--color-ink-900);
  }

  .modal-input kbd {
    font-family: var(--font-display);
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: 6px;
    border: 1px solid rgba(14, 165, 233, 0.3);
    background: rgba(14, 165, 233, 0.1);
  }

  .search-results {
    overflow-y: auto;
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .search-hint {
    text-align: center;
    color: var(--color-ink-400);
    font-size: 0.88rem;
    padding: 1.4rem 0;
    margin: 0;
  }

  .result-item {
    display: block;
    padding: 0.85rem 1rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(56, 189, 248, 0.2);
    background: rgba(255, 255, 255, 0.55);
    cursor: pointer;
  }

  .result-item.active,
  .result-item:hover {
    background: rgba(56, 189, 248, 0.14);
  }

  .result-type {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-ice-700);
  }

  .result-title {
    display: block;
    font-weight: 600;
    margin: 0.25rem 0;
    color: var(--color-ink-900);
  }

  .result-excerpt {
    display: block;
    font-size: 0.82rem;
    color: var(--color-ink-500);
    line-height: 1.5;
  }

  mark {
    background: rgba(56, 189, 248, 0.35);
    color: inherit;
    border-radius: 3px;
    padding: 0 2px;
  }
</style>

<script>
  const overlay = document.getElementById('search-overlay') as HTMLElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsBox = document.getElementById('search-results') as HTMLElement;
  const base = import.meta.env.BASE_URL;

  let pagefind: any = null;
  let currentResults: HTMLElement[] = [];
  let activeIndex = -1;
  let debounceTimer: ReturnType<typeof setTimeout>;

  async function openModal() {
    overlay.hidden = false;
    input.value = '';
    resultsBox.innerHTML = '<p class="search-hint">加载搜索索引中…</p>';
    currentResults = [];
    activeIndex = -1;
    setTimeout(() => input.focus(), 40);

    if (!pagefind) {
      try {
        const url = `${base}pagefind/pagefind.js`;
        pagefind = await import(/* @vite-ignore */ url);
        await pagefind.init();
        resultsBox.innerHTML = '<p class="search-hint">输入关键词，结果将显示在这里</p>';
      } catch {
        resultsBox.innerHTML =
          '<p class="search-hint">搜索索引不可用。若在本地开发，请先运行 npm run build 与 npm run preview 再测试。</p>';
      }
    }
  }

  function closeModal() {
    overlay.hidden = true;
  }

  window.addEventListener('prism:search-open', openModal);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.hidden) closeModal();
  });

  function setActive(index: number) {
    activeIndex = index;
    currentResults.forEach((el, i) => el.classList.toggle('active', i === index));
    currentResults[index]?.scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (currentResults.length) setActive((activeIndex + 1) % currentResults.length);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (currentResults.length)
        setActive((activeIndex - 1 + currentResults.length) % currentResults.length);
    } else if (e.key === 'Enter' && activeIndex >= 0) {
      currentResults[activeIndex].click();
    }
  });

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const query = input.value.trim();
    if (!query) {
      resultsBox.innerHTML = '<p class="search-hint">输入关键词，结果将显示在这里</p>';
      currentResults = [];
      return;
    }
    debounceTimer = setTimeout(() => runSearch(query), 250);
  });

  async function runSearch(query: string) {
    if (!pagefind) return;
    resultsBox.innerHTML = '<p class="search-hint">搜索中…</p>';
    try {
      const search = await pagefind.search(query);
      const items = await Promise.all(search.results.slice(0, 10).map((r: any) => r.data()));

      if (!items.length) {
        resultsBox.innerHTML = '<p class="search-hint">没有找到相关内容，换个关键词试试。</p>';
        currentResults = [];
        return;
      }

      resultsBox.innerHTML = '';
      currentResults = [];
      items.forEach((data: any) => {
        const a = document.createElement('a');
        a.className = 'result-item';
        let url: string = data.url;
        if (!url.startsWith(base)) url = base.replace(/\/$/, '') + (url.startsWith('/') ? url : '/' + url);
        a.href = url;
        const type = url.includes('/tutorials') ? '教程' : '提示词';
        a.innerHTML = `
          <span class="result-type">${type}</span>
          <span class="result-title">${data.meta.title ?? '无标题'}</span>
          <span class="result-excerpt">${data.excerpt ?? ''}</span>
        `;
        resultsBox.appendChild(a);
        currentResults.push(a);
      });
      setActive(0);
    } catch (err) {
      resultsBox.innerHTML = '<p class="search-hint">搜索出错，请稍后再试。</p>';
    }
  }
</script>
