---
import BaseLayout from '../layouts/BaseLayout.astro';
import { models, compareDimensions } from '../data/models';

// 中文能力排序权重：优秀 > 良好 > 一般
const chineseRank: Record<string, number> = { 优秀: 1, 良好: 2, 一般: 3 };
---

<BaseLayout title="模型对比 · Prism AI 棱镜" description="主流 AI 模型特点、强项与适用场景对比，帮你根据任务选择合适的模型。">
  <section class="page">
    <header class="page-head reveal">
      <h1>AI 模型对比</h1>
      <p>没有「最好」的模型，只有最适合当前任务的模型。按强项和场景选，比盲目追新更重要。</p>
      <p class="disclaimer">以下为定性梳理，能力与价格随版本快速变化，具体请以各厂商官方最新说明为准。</p>
    </header>

    <!-- 筛选栏 -->
    <div class="filters glass-panel reveal">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
        </svg>
        <input id="model-search" type="search" placeholder="搜索模型、厂商或适用场景…" aria-label="搜索模型" />
      </div>

      <div class="filter-row">
        <div class="chip-group" role="group" aria-label="按中文能力筛选">
          <span class="group-label">中文</span>
          <button class="chip active" type="button" data-filter="chinese" data-value="all">全部</button>
          <button class="chip" type="button" data-filter="chinese" data-value="优秀">优秀</button>
          <button class="chip" type="button" data-filter="chinese" data-value="良好">良好</button>
          <button class="chip" type="button" data-filter="chinese" data-value="一般">一般</button>
        </div>
        <div class="chip-group" role="group" aria-label="按访问方式筛选">
          <span class="group-label">访问</span>
          <button class="chip active" type="button" data-filter="access" data-value="all">全部</button>
          <button class="chip" type="button" data-filter="access" data-value="国内直连">国内直连</button>
          <button class="chip" type="button" data-filter="access" data-value="需网络条件">需网络条件</button>
        </div>
      </div>

      <div class="select-row">
        <label class="select-label">
          排序
          <select id="sort-select" aria-label="排序方式">
            <option value="default">默认顺序</option>
            <option value="name">按名称</option>
            <option value="chinese">按中文能力</option>
          </select>
        </label>
        <span class="result-count" id="result-count" aria-live="polite"></span>
        <button id="reset-btn" class="reset-btn" type="button">重置筛选</button>
      </div>
    </div>

    <div class="model-grid" id="model-grid">
      {
        models.map((m) => (
          <article
            class="model-card glass-card glass-card--hover flow-border reveal"
            data-chinese={m.chinese}
            data-access={m.access}
            data-rank={chineseRank[m.chinese]}
            data-name={m.name}
            data-search={[m.name, m.vendor, m.bestFor, m.strengths.join(' '), m.note]
              .join(' ')
              .toLowerCase()}
          >
            <div class="model-card-head">
              <h2>{m.name}</h2>
              <span class="badge">{m.vendor}</span>
            </div>
            <ul class="strength-list">
              {m.strengths.map((s) => <li>{s}</li>)}
            </ul>
            <p class="best-for"><span class="bf-label">最适合</span>{m.bestFor}</p>
            <div class="model-meta">
              <span>中文 · {m.chinese}</span>
              <span>{m.access}</span>
              <span>{m.pricing}</span>
            </div>
            <p class="note">{m.note}</p>
          </article>
        ))
      }
    </div>

    <div class="empty-state" id="empty-state" hidden>
      <p>没有符合条件的模型，换个关键词或重置筛选试试。</p>
      <button class="btn btn-ghost" id="reset-empty" type="button">重置筛选</button>
    </div>

    <section class="table-section reveal" id="table-section">
      <h2>速查对比表</h2>
      <div class="table-wrap glass-panel">
        <table>
          <thead>
            <tr>
              <th>模型</th>
              {compareDimensions.map((d) => <th>{d.label}</th>)}
            </tr>
          </thead>
          <tbody id="table-body">
            {
              models.map((m) => (
                <tr
                  data-chinese={m.chinese}
                  data-access={m.access}
                  data-rank={chineseRank[m.chinese]}
                  data-name={m.name}
                >
                  <th class="row-head">{m.name}</th>
                  <td>{m.vendor}</td>
                  <td>{m.bestFor}</td>
                  <td>{m.chinese}</td>
                  <td>{m.access}</td>
                  <td>{m.pricing}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .page-head h1 {
    font-family: var(--font-display);
    font-size: 2.2rem;
    margin: 0 0 0.5rem;
  }

  .page-head p {
    color: var(--color-ink-500);
    margin: 0 0 0.5rem;
  }

  .disclaimer {
    font-size: 0.85rem;
    color: var(--color-ink-400);
  }

  /* ===== 筛选栏 ===== */
  .filters {
    padding: 1.3rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 2rem 0;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    border-radius: 999px;
    background: var(--surface-solid);
    border: 1px solid var(--border-mid);
    color: var(--text-muted);
  }

  .search-box input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    color: var(--color-ink-900);
    outline: none;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .group-label {
    font-size: 0.82rem;
    color: var(--text-faint);
    font-weight: 600;
    margin-right: 0.2rem;
  }

  .chip {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border-mid);
    background: var(--surface-solid);
    color: var(--text-body);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .chip:hover {
    background: rgba(56, 189, 248, 0.14);
  }

  .chip.active {
    background: linear-gradient(135deg, #38bdf8, #0ea5e9);
    color: #fff;
    border-color: transparent;
  }

  .select-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .select-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--color-ink-700);
  }

  .select-label select {
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border-mid);
    background: var(--surface-strong);
    color: var(--text-strong);
    font-size: 0.88rem;
    cursor: pointer;
  }

  .result-count {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .reset-btn {
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--border-mid);
    background: var(--surface-solid);
    color: var(--text-body);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .reset-btn:hover {
    background: rgba(56, 189, 248, 0.14);
  }

  /* ===== 卡片 ===== */
  .model-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin: 2rem 0 3rem;
  }

  .model-card {
    padding: 1.6rem 1.7rem;
    display: flex;
    flex-direction: column;
  }

  .model-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .model-card-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .strength-list {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    color: var(--color-ink-700);
    font-size: 0.92rem;
  }

  .strength-list li {
    margin-bottom: 0.35rem;
  }

  .best-for {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--color-ink-700);
    line-height: 1.7;
  }

  .bf-label {
    display: inline-block;
    font-weight: 700;
    color: var(--color-ice-700);
    margin-right: 0.4rem;
  }

  .model-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .model-meta span {
    font-size: 0.78rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    color: var(--text-body);
  }

  .note {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-ink-500);
    line-height: 1.7;
  }

  /* ===== 空状态 ===== */
  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-ink-500);
  }

  .empty-state .btn {
    margin-top: 1rem;
  }

  /* ===== 表格 ===== */
  .table-section h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin: 0 0 1rem;
  }

  .table-wrap {
    padding: 0.5rem;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border-soft);
    color: var(--color-ink-700);
    vertical-align: top;
  }

  thead th {
    color: var(--color-ink-900);
    font-weight: 700;
    background: rgba(56, 189, 248, 0.1);
  }

  tbody tr {
    transition: background 0.15s ease;
  }

  tbody tr:hover {
    background: rgba(56, 189, 248, 0.12);
  }

  .row-head {
    color: var(--color-ice-700);
    font-weight: 700;
  }

  @media (max-width: 850px) {
    .model-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('model-search') as HTMLInputElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.model-card'));
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#table-body tr'));
  const grid = document.getElementById('model-grid') as HTMLElement;
  const tableBody = document.getElementById('table-body') as HTMLElement;
  const tableSection = document.getElementById('table-section') as HTMLElement;
  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const resultCount = document.getElementById('result-count') as HTMLElement;

  const state: Record<string, string> = { chinese: 'all', access: 'all' };
  const rowByName = new Map(rows.map((r) => [r.dataset.name, r]));

  function matches(card: HTMLElement): boolean {
    const keyword = searchInput.value.trim().toLowerCase();
    const okKeyword = !keyword || (card.dataset.search ?? '').includes(keyword);
    const okChinese = state.chinese === 'all' || card.dataset.chinese === state.chinese;
    const okAccess = state.access === 'all' || card.dataset.access === state.access;
    return okKeyword && okChinese && okAccess;
  }

  function orderedVisible(): HTMLElement[] {
    const visible = cards.filter(matches);
    const mode = sortSelect.value;
    if (mode === 'name') {
      visible.sort((a, b) => (a.dataset.name ?? '').localeCompare(b.dataset.name ?? 'zh'));
    } else if (mode === 'chinese') {
      visible.sort(
        (a, b) =>
          Number(a.dataset.rank) - Number(b.dataset.rank) ||
          (a.dataset.name ?? '').localeCompare(b.dataset.name ?? 'zh'),
      );
    }
    return visible;
  }

  function syncUrl() {
    const params = new URLSearchParams(location.search);
    const keyword = searchInput.value.trim();
    if (keyword) params.set('q', keyword);
    else params.delete('q');
    if (state.chinese !== 'all') params.set('chinese', state.chinese);
    else params.delete('chinese');
    if (state.access !== 'all') params.set('access', state.access);
    else params.delete('access');
    if (sortSelect.value !== 'default') params.set('sort', sortSelect.value);
    else params.delete('sort');
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function applyFilters() {
    const visible = orderedVisible();
    const visibleNames = new Set(visible.map((c) => c.dataset.name));

    cards.forEach((card) => {
      const show = visibleNames.has(card.dataset.name);
      card.style.display = show ? '' : 'none';
      const tr = rowByName.get(card.dataset.name);
      if (tr) tr.style.display = show ? '' : 'none';
    });

    // 默认顺序且全部可见时，DOM 本就是服务端渲染顺序，跳过重排以减少布局抖动
    const needsReorder = sortSelect.value !== 'default' || visible.length !== cards.length;
    if (needsReorder) {
      // 可见卡片/行按排序顺序重排，隐藏的统一移到末尾
      visible.forEach((card) => {
        grid.appendChild(card);
        const tr = rowByName.get(card.dataset.name);
        if (tr) tableBody.appendChild(tr);
      });
      cards
        .filter((c) => !visibleNames.has(c.dataset.name))
        .forEach((card) => {
          grid.appendChild(card);
          const tr = rowByName.get(card.dataset.name);
          if (tr) tableBody.appendChild(tr);
        });
    }

    const count = visible.length;
    resultCount.textContent = `共 ${count} / ${cards.length} 个模型`;
    emptyState.hidden = count !== 0;
    grid.hidden = count === 0;
    tableSection.hidden = count === 0;
    syncUrl();
  }

  function resetAll() {
    searchInput.value = '';
    sortSelect.value = 'default';
    state.chinese = 'all';
    state.access = 'all';
    chips.forEach((c) =>
      c.classList.toggle('active', c.dataset.value === 'all'),
    );
    applyFilters();
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter ?? '';
      state[filter] = chip.dataset.value ?? 'all';
      chips
        .filter((c) => c.dataset.filter === filter)
        .forEach((c) => c.classList.toggle('active', c === chip));
      applyFilters();
    });
  });

  searchInput.addEventListener('input', applyFilters);
  sortSelect.addEventListener('change', applyFilters);
  document.getElementById('reset-btn')?.addEventListener('click', resetAll);
  document.getElementById('reset-empty')?.addEventListener('click', resetAll);

  // 初始化：读取 URL 状态
  const params = new URLSearchParams(location.search);
  const initQ = params.get('q');
  const initChinese = params.get('chinese');
  const initAccess = params.get('access');
  const initSort = params.get('sort');
  if (initQ) searchInput.value = initQ;
  if (initSort) sortSelect.value = initSort;
  if (initChinese) state.chinese = initChinese;
  if (initAccess) state.access = initAccess;
  chips.forEach((c) => {
    const f = c.dataset.filter ?? '';
    c.classList.toggle('active', c.dataset.value === state[f]);
  });
  // 默认状态（URL 无参数）下服务端已渲染正确，不操作全部卡片，避免触发屏幕外字体分片与布局
  if (params.toString()) {
    applyFilters();
  } else {
    resultCount.textContent = `共 ${cards.length} / ${cards.length} 个模型`;
  }
</script>
