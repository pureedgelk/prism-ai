---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resourceGroups } from '../data/resources';

const total = resourceGroups.reduce((sum, g) => sum + g.items.length, 0);
---

<BaseLayout title="资源导航 · Prism AI 棱镜" description="精选 AI 对话模型、提示词学习、图像视频与效率开发工具，分类整理的导航页。">
  <section class="page">
    <header class="page-head reveal">
      <h1>资源导航</h1>
      <p>精选 {total} 个常用 AI 工具与学习资源，按用途分类，点击卡片直达官方网站。</p>
    </header>

    <div class="filters glass-panel reveal">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
        </svg>
        <input id="resource-search" type="search" placeholder="搜索工具名称或用途…" aria-label="搜索资源" />
      </div>
    </div>

    {
      resourceGroups.map((group) => (
        <section class="group" data-group>
          <div class="group-head reveal">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0ea5e9" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={group.icon} />
            </svg>
            <h2>{group.category}</h2>
          </div>
          <div class="resource-grid">
            {
              group.items.map((item) => (
                <a
                  class="resource-card glass-card glass-card--hover flow-border reveal"
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-search={`${item.name} ${item.desc} ${item.tag} ${group.category}`.toLowerCase()}
                >
                  <div class="card-top">
                    <h3>{item.name}</h3>
                    <span class="badge">{item.tag}</span>
                  </div>
                  <p>{item.desc}</p>
                  <span class="go-link">
                    前往
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg>
                  </span>
                </a>
              ))
            }
          </div>
        </section>
      ))
    }

    <div class="empty-state" id="empty-state" hidden>
      <p>没有找到匹配的资源，换个关键词试试。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .page-head h1 {
    font-family: var(--font-display);
    font-size: 2.2rem;
    margin: 0 0 0.5rem;
  }

  .page-head p {
    color: var(--color-ink-500);
    margin: 0 0 2rem;
  }

  .filters {
    padding: 1.1rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: var(--color-ink-500);
  }

  .search-box input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    color: var(--color-ink-900);
    outline: none;
  }

  .group {
    margin-bottom: 2.5rem;
  }

  .group-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
  }

  .group-head h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 0;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }

  .resource-card {
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .card-top h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .resource-card p {
    margin: 0 0 1rem;
    color: var(--color-ink-500);
    font-size: 0.87rem;
    line-height: 1.7;
    flex: 1;
  }

  .go-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ice-700);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-ink-500);
  }

  @media (max-width: 900px) {
    .resource-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const input = document.getElementById('resource-search') as HTMLInputElement;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.resource-card'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
  const emptyState = document.getElementById('empty-state') as HTMLElement;

  input.addEventListener('input', () => {
    const keyword = input.value.trim().toLowerCase();
    let totalShown = 0;

    groups.forEach((group) => {
      let groupShown = 0;
      group.querySelectorAll<HTMLElement>('.resource-card').forEach((card) => {
        const show = !keyword || (card.dataset.search ?? '').includes(keyword);
        card.style.display = show ? '' : 'none';
        if (show) groupShown++;
      });
      group.style.display = groupShown ? '' : 'none';
      totalShown += groupShown;
    });

    emptyState.hidden = totalShown !== 0;
  });
</script>
