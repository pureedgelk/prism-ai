---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Prompt = CollectionEntry<'prompts'>;

export async function getStaticPaths() {
  const entries = (await getCollection('prompts')).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    render: { default: entry },
    props: {
      entry,
      prev: entries[i - 1] ?? null,
      next: entries[i + 1] ?? null,
    },
  }));
}

interface Props {
  entry: Prompt;
  prev: Prompt | null;
  next: Prompt | null;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const rawBody = entry.body ?? '';

function fmtDate(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
---

<BaseLayout title={`${entry.data.title} · Prism AI 棱镜`} description={entry.data.description}>
  <div class="progress-track" aria-hidden="true">
    <div class="progress-bar" id="progress-bar"></div>
  </div>

  <article class="prompt-detail">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={base}>首页</a>
      <span>/</span>
      <a href={base + 'prompts'}>提示词库</a>
      <span>/</span>
      <span class="current">{entry.data.category}</span>
    </nav>

    <header class="detail-head">
      <div class="detail-meta">
        <span class="badge">{entry.data.category}</span>
        {entry.data.featured && <span class="featured-tag">精选</span>}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="detail-desc">{entry.data.description}</p>
      <div class="detail-info">
        <time datetime={fmtDate(entry.data.date)}>{fmtDate(entry.data.date)}</time>
        <span class="info-dot">·</span>
        <span class="model-list">
          {entry.data.models.map((m) => <span class="model-tag">{m}</span>)}
        </span>
      </div>
      <div class="detail-tags">
        {entry.data.tags.map((t) => <span class="mini-tag">#{t}</span>)}
      </div>

      <div
        class="detail-interactions"
        data-interactive
        data-kind="prompt"
        data-id={entry.id}
        data-actions="bookmark,like,read"
      >
      </div>
    </header>

    <section class="prompt-card glass-card flow-border" aria-label="提示词正文">
      <div class="card-toolbar">
        <h2>提示词正文</h2>
        <button id="copy-prompt" class="btn btn-primary btn-copy" type="button" data-copy={rawBody}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span>一键复制</span>
        </button>
      </div>
      <div class="prompt-content" id="prompt-content">
        <Content />
      </div>
      <p class="use-hint">复制后直接粘贴给 AI；【】中的内容按你的实际情况替换。</p>
    </section>

    <nav class="post-nav" aria-label="提示词导航">
      {
        prev && (
          <a class="post-nav-card glass-card flow-border" href={`${base}prompts/${prev.id}`} rel="prev">
            <span class="nav-direction">上一篇</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a class="post-nav-card glass-card flow-border next" href={`${base}prompts/${next.id}`} rel="next">
            <span class="nav-direction">下一篇</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>

  <button id="back-to-top" class="back-to-top" type="button" aria-label="返回顶部" hidden>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 19V5M5 12l7-7 7 7" />
    </svg>
  </button>
</BaseLayout>

<style>
  .progress-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: rgba(56, 189, 248, 0.12);
  }

  .progress-bar {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #38bdf8, #0ea5e9);
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.6);
    transition: width 0.1s linear;
  }

  .prompt-detail {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-500);
    margin-bottom: 2rem;
  }

  .breadcrumb a:hover {
    color: var(--color-ice-700);
  }

  .breadcrumb .current {
    color: var(--color-ink-700);
  }

  .detail-head {
    margin-bottom: 2rem;
  }

  .detail-meta {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .featured-tag {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(135deg, #38bdf8, #0ea5e9);
  }

  .detail-head h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    line-height: 1.3;
    margin: 0 0 0.8rem;
  }

  .detail-desc {
    color: var(--color-ink-500);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .detail-info {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-ink-400);
    font-family: var(--font-display);
  }

  .info-dot {
    color: var(--color-ink-400);
  }

  .model-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .model-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ice-700);
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.14);
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .mini-tag {
    font-size: 0.78rem;
    color: var(--color-ink-500);
  }

  .detail-interactions {
    margin-top: 1.4rem;
  }

  .prompt-card {
    padding: 1.6rem 1.7rem;
  }

  .card-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .card-toolbar h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin: 0;
  }

  .btn-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.2rem;
    font-size: 0.9rem;
  }

  .prompt-content {
    font-size: 0.98rem;
    line-height: 1.9;
    color: var(--color-ink-700);
  }

  .prompt-content > :last-child {
    margin-bottom: 0;
  }

  .prompt-content p {
    margin: 0 0 1rem;
  }

  .prompt-content ol,
  .prompt-content ul {
    margin: 0 0 1rem;
    padding-left: 1.5rem;
  }

  .prompt-content li {
    margin-bottom: 0.5rem;
  }

  .use-hint {
    margin: 1.2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(56, 189, 248, 0.2);
    font-size: 0.82rem;
    color: var(--color-ink-400);
  }

  .post-nav {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .post-nav-card {
    padding: 1.2rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .post-nav-card.next {
    text-align: right;
  }

  .nav-direction {
    font-size: 0.78rem;
    color: var(--color-ink-400);
  }

  .nav-title {
    font-weight: 600;
    color: var(--color-ink-900);
  }

  .back-to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(56, 189, 248, 0.35);
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    color: var(--color-ice-700);
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(14, 165, 233, 0.25);
    z-index: 45;
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .card-toolbar {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  import '../../scripts/interactions';

  const progressBar = document.getElementById('progress-bar') as HTMLElement;
  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = docHeight > 0 ? scrollTop / docHeight : 0;
    progressBar.style.width = `${Math.min(100, ratio * 100)}%`;
  }

  // 一键复制
  const copyBtn = document.getElementById('copy-prompt') as HTMLButtonElement;
  copyBtn?.addEventListener('click', async () => {
    const text = copyBtn.dataset.copy ?? '';
    const label = copyBtn.querySelector('span');
    const original = label?.textContent;
    try {
      await navigator.clipboard.writeText(text);
      if (label) label.textContent = '已复制 ✓';
    } catch {
      if (label) label.textContent = '复制失败，请手动选择';
    }
    setTimeout(() => {
      if (label) label.textContent = original ?? '一键复制';
    }, 1800);
  });

  // 返回顶部
  const backToTop = document.getElementById('back-to-top') as HTMLElement;
  window.addEventListener(
    'scroll',
    () => {
      updateProgress();
      backToTop.hidden = window.scrollY < 400;
    },
    { passive: true },
  );
  backToTop.addEventListener('click', () =>
    window.scrollTo({ top: 0, behavior: 'smooth' }),
  );
  updateProgress();
</script>
