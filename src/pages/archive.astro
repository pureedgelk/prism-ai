---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const prompts = await getCollection('prompts');
const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);

type ArchiveEntry = {
  type: string;
  title: string;
  category: string;
  date: Date;
  href: string;
};

const all: ArchiveEntry[] = [
  ...prompts.map((p) => ({
    type: '提示词',
    title: p.data.title,
    category: p.data.category,
    date: p.data.date,
    href: `${base}prompts`,
  })),
  ...tutorials.map((t) => ({
    type: '教程',
    title: t.data.title,
    category: t.data.category,
    date: t.data.date,
    href: `${base}tutorials/${t.id}`,
  })),
];

function monthKey(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
}

const monthMap = new Map<string, ArchiveEntry[]>();
all
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .forEach((entry) => {
    const key = monthKey(entry.date);
    if (!monthMap.has(key)) monthMap.set(key, []);
    monthMap.get(key)!.push(entry);
  });

const months = [...monthMap.entries()];
const total = all.length;
---

<BaseLayout title="更新归档 · Prism AI 棱镜" description="按年月汇总的全部提示词与教程，方便回溯历史更新。">
  <section class="page">
    <header class="page-head reveal">
      <h1>更新归档</h1>
      <p>共 {total} 条内容，按年月倒序排列，点击标题直接查看。</p>
    </header>

    {
      months.map(([month, entries]) => (
        <section class="month-block reveal">
          <div class="month-head">
            <h2>{month}</h2>
            <span class="month-count">{entries.length} 条</span>
          </div>
          <ul class="archive-list glass-panel">
            {
              entries.map((e) => (
                <li>
                  <a href={e.href}>
                    <span class:list={['type-badge', e.type === '教程' ? 'is-tutorial' : 'is-prompt']}>{e.type}</span>
                    <span class="archive-title">{e.title}</span>
                    <span class="archive-meta">
                      <span class="badge">{e.category}</span>
                      <time>{monthKey(e.date)}-{String(e.date.getDate()).padStart(2, '0')}</time>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .page-head h1 {
    font-family: var(--font-display);
    font-size: 2.2rem;
    margin: 0 0 0.5rem;
  }

  .page-head p {
    color: var(--color-ink-500);
    margin: 0 0 2.2rem;
  }

  .month-block {
    margin-bottom: 2rem;
  }

  .month-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .month-head h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 0;
    color: var(--color-ink-900);
  }

  .month-count {
    font-size: 0.82rem;
    color: var(--color-ink-400);
  }

  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.2rem;
  }

  .archive-list li {
    border-bottom: 1px solid rgba(56, 189, 248, 0.14);
  }

  .archive-list li:last-child {
    border-bottom: none;
  }

  .archive-list a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 0.2rem;
    flex-wrap: wrap;
  }

  .type-badge {
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .is-prompt {
    color: #0369a1;
    background: rgba(56, 189, 248, 0.18);
  }

  .is-tutorial {
    color: #075985;
    background: rgba(14, 165, 233, 0.25);
  }

  .archive-title {
    flex: 1;
    min-width: 12rem;
    font-size: 0.95rem;
    color: var(--color-ink-900);
    font-weight: 500;
  }

  .archive-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .archive-meta time {
    font-size: 0.8rem;
    color: var(--color-ink-400);
    font-family: var(--font-display);
  }
</style>
